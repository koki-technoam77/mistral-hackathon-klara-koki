# ─── Required ─────────────────────────────────────────────────────────────────
MISTRAL_API_KEY=your_mistral_api_key
KOTOFLOW_API_KEY=your_api_key_for_auth

# ─── Voice & Avatar ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
ANAM_API_KEY=your_anam_api_key
ANAM_AVATAR_ID=your_avatar_id

# ─── Composio (for real action execution) ────────────────────────────────────
COMPOSIO_API_KEY=your_composio_api_key

# ─── Observability ───────────────────────────────────────────────────────────
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=kotoflow

# ─── Fine-tuned model (optional) ────────────────────────────────────────────
FT_MODEL_NAME=

# ─── CORS & Domains ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
ALLOWED_DOMAINS=api.mistral.ai,api.elevenlabs.io,api.composio.dev,api.wandb.ai,api.anam.ai

# ─── Character persistence ──────────────────────────────────────────────────
CHARACTER_STORAGE_DIR=/tmp/kotoflow_characters

# ─── Multi-AI Team (optional) ───────────────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# AI_TEAM_DEFAULT_STRATEGY=route
